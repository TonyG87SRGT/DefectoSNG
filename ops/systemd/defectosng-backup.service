[Unit]
Description=Create and verify a DefectoSNG production backup
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-defectosng
User=root
Group=root
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/defectosng
